# ─── Server ───────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# Express session — generate with: openssl rand -hex 32
SESSION_SECRET=change_me_to_a_random_64_char_hex_string

# Origin of the React client (used for CORS + OAuth redirect)
CLIENT_ORIGIN=https://your-domain.com

# ─── Google OAuth 2.0 ────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: https://your-domain.com/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-domain.com/auth/google/callback

# ─── Anthropic Claude API ─────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── Access Control ───────────────────────────────────────
# Comma-separated list of allowed Google email addresses.
# Leave blank to allow any authenticated Google account.
ALLOWED_EMAILS=alice@example.com,bob@example.com
